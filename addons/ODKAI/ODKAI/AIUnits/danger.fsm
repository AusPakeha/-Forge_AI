                         "_isLandVehicle = ( typeOf ( vehicle _this ) ) isKindOf ""LandVehicle"";" \n
                         "_ArmedVehicle = !( ( ( vehicle _this emptyPositions ""gunner"" ) != 0 ) OR ( ( vehicle _this magazinesTurret [ [ 0 ] , false ] ) isEqualTo [] ) );" \n
