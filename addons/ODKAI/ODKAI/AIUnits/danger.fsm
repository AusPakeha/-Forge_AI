                         "comment ""9  DCBulletClose"";" \n
                         "*/" \n
                         "[ _this , _dangerCause ] call ODKAI_Danger;" \n
                         "_checkVARGroup = group _this getvariable ""ODKAI_HashMap"";" \n
                         "_checkVARUnit = _this getvariable ""ODKAI_HashMapUnit"";" \n
