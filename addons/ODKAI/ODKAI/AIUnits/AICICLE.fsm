                                        itemno = 23;
                                        priority = 4.000000;
                                        to="INFANTRY";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_LastTimeCheckLoadout < ( diag_ticktime - _RandomTickCheckLoadout )"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"_this call ODKAI_CheckLoadout;	" \n
                                         "_this call ODKAI_MinesRoads;			" \n
                                         "_LastTimeCheckLoadout = diag_ticktime;" \n
                                         "_RandomTickCheckLoadout = 20 + ( random 10 );"/*%FSM</ACTION""">*/;
                                };
