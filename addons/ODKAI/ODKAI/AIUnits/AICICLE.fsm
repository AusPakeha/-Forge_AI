*//*%FSM</HEAD>*/
class FSM
{
        fsmName = "AICIRLE";
        class States
        {
                /*%FSM<STATE "START">*/
                class START
                {
                        name = "START";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"if ( leader _this isEqualTo _this ) then { _this call ODKAI_InitHashGroup; };" \n
                         "" \n
                         "_this call ODKAI_AI_Init;" \n
                         "" \n
                         "[ _this , ""FSM"" , _thisFSM ] call ODKAI_SetUnitMemory;" \n
                         "_LastTimeCheck_LeaderPos = diag_ticktime + ( 60 + random 100 );" \n
                         "_RandomTick_LeaderPos = 0;" \n
                         "_LastTimeCheckLoadout = diag_ticktime; //da rimettere random" \n
                         "_RandomTickCheckLoadout = 0;" \n
                         "_LastTimeInCombat = diag_ticktime + ( random 10 );" \n
                         "_RandomTickInCombat = 0;" \n
                         "_isAutonomous =  tolower getText (configfile >> ""CfgVehicles"" >> typeOf (vehicle _this) >> ""vehicleClass"") isEqualTo ""autonomous"";" \n
                         "" \n
                         "private _Group = _this;" \n
                         "" \n
                         "{" \n
                         "	if !(isPlayer _x) then" \n
                         "	{" \n
                         "		if !ODK_USESTATICS exitWith {}; " \n
                         "		_x disableAI ""RADIOPROTOCOL"";" \n
                         "" \n
                         "	};" \n
                         "} foreach (units _Group);" \n
                         "" \n
                         "_onFoot = isNull objectParent _this;" \n
                         "if _onFoot then {	" \n
                         "		if ODK_SECONDCHANCEWEST then { _this call ODKAI_WEST };" \n
                         "		if ODK_SECONDCHANCEEAST then { _this call ODKAI_EAST };	" \n
                         "		if ODK_SECONDCHANCEINDEPENDENT then { _this call ODKAI_INDEPEND };	" \n
                         "};"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "TRUE">*/
                                class TRUE
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="AICIRCLE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"TRUE"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "AICIRCLE">*/
                class AICIRCLE
                {
                        name = "AICIRCLE";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"_stopTime = 1;" \n
                         "_checkVARGroup = group _this getvariable ""ODKAI_HashMap"";" \n
                         "_checkVARUnit = _this getvariable ""ODKAI_HashMapUnit"";" \n
                         "" \n
                         "_inSuppression = false;" \n
                         "_IsLeader = leader _this isEqualTo _this;" \n
                         "_Enemy = ( _this findNearestEnemy getposATL _this );" \n
                         "_In_Combat = !isNull _Enemy;" \n
                         "_onFoot = isNull objectParent _this;" \n
                         "_isAir = ( typeOf ( vehicle _this ) ) isKindOf ""AIR"";" \n
                         "_isLandVehicle = ( typeOf ( vehicle _this ) ) isKindOf ""LandVehicle"";	" \n
                         "_this call ODKAI_ArmedVehNearby;	" \n
                         "_this call ODKAI_ReturnFormation;" \n
                         "if _IsLeader then {	" \n
                         "	_this call ODKAI_ChangeBehaviour; 	" \n
                         "" \n
                         "			" \n
                         "};"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "EXIT_CONDITION_">*/
                                class EXIT_CONDITION_
                                {
                                        itemno = 3;
                                        priority = 6.000000;
                                        to="FSM_END";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"( IsPlayer _this ) OR " \n
                                         "!( missionnamespace getvariable [ ""ODK_ActivateAI"" , true ] ) OR" \n
                                         "! local _this OR" \n
                                         "! alive _this"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "NO_VAR_">*/
                                class NO_VAR_
                                {
                                        itemno = 52;
                                        priority = 5.000000;
                                        to="WAITING_TIME";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"( isnil ""_checkVARGroup"" ) OR" \n
                                         "( isnil ""_checkVARUnit"" )"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "INFANTRY_">*/
                                class INFANTRY_
                                {
                                        itemno = 7;
                                        priority = 4.000000;
                                        to="INFANTRY";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_onFoot"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "LAND_VEHICLES_">*/
                                class LAND_VEHICLES_
                                {
                                        itemno = 12;
                                        priority = 3.000000;
                                        to="LAND_VEHICLES";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_isLandVehicle" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "AIR_VEHICLES_">*/
                                class AIR_VEHICLES_
                                {
                                        itemno = 14;
                                        priority = 2.000000;
                                        to="AIR__VEHICLES";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_isAir"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "AUTONOMOUS_">*/
                                class AUTONOMOUS_
                                {
                                        itemno = 13;
                                        priority = 1.000000;
                                        to="WAITING_TIME";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_isAutonomous" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"_this call ODKAI_Autonomous;" \n
                                         "_stopTime = 1;"/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "TRUE">*/
                                class TRUE
                                {
                                        itemno = 11;
                                        priority = 0.000000;
                                        to="WAITING_TIME";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"TRUE"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "FSM_END">*/
                class FSM_END
                {
                        name = "FSM_END";
                        itemno = 4;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "ODKAI_UnitControlled = ODKAI_UnitControlled - [ _this ];" \n
                         "	" \n
                         "if ( ( isUAVConnected ( vehicle _this ) ) AND" \n
                         "	  !( ( vehicle _this ) getvariable [ ""odkai_UAVDisabled"" , false ] ) " \n
                         ") then {	" \n
                         "	( vehicle _this ) setVariable [ ""odkai_UAVDisabled"" , true , true ];	" \n
                         "};"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "WAITING_TIME">*/
                class WAITING_TIME
                {
                        name = "WAITING_TIME";
                        itemno = 5;
                        init = /*%FSM<STATEINIT""">*/"_stopTime = 1;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "TIME_ELAPSED">*/
                                class TIME_ELAPSED
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="AICIRCLE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"if _inSuppression then {" \n
                                         "" \n
                                         "" \n
                                         "};"/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "INFANTRY">*/
                class INFANTRY
                {
                        name = "INFANTRY";
                        itemno = 8;
                        init = /*%FSM<STATEINIT""">*/"_stopTime = 1;" \n
                         "_this call ODKAI_SeeLaser;	" \n
                         "_this call ODKAI_AUTOMEDIC;	" \n
                         "_this call ODKAI_LaserDesignationMan;" \n
                         "" \n
                         "" \n
                         "		if ( _this distance2d _Enemy > 2000 ) then { " \n
                         "			_this setUnitPos ""up"";" \n
                         "			};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
